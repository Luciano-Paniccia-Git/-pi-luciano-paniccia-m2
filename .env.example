# Copiar este archivo a ".env" (o exportar las variables en tu shell) y
# completar con tu API key real. NUNCA subir el .env real al repositorio.

OPENAI_API_KEY=sk-tu-api-key-real

# Modelo de embeddings usado tanto para indexar como para consultar
# (tienen que ser el mismo modelo, o los vectores no son comparables entre sí)
EMBEDDING_MODEL=text-embedding-3-small

# Modelo de chat usado para generar la respuesta final (RAG)
CHAT_MODEL=gpt-4o-mini

# Modelo usado por el agente evaluador (bonus). Puede ser el mismo que CHAT_MODEL.
EVAL_MODEL=gpt-4o-mini
